<?xml version="1.0" encoding="utf-8"?>
<!--
  The secret store keeps its ciphertext in the app's own preferences. It must never leave the
  device in a backup or a device transfer, so it is excluded here (Android 12 and above).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="openmedia_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="openmedia_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
